# Node
TZ=UTC
PORT=3333
HOST=127.0.0.1
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
SERVICE_TOKEN=change-me
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
OPENROUTER_IMAGE_SIZE=1024x640
OPENROUTER_IMAGE_QUALITY=low
OPENROUTER_IMAGE_OUTPUT_FORMAT=jpeg
OPENROUTER_IMAGE_OUTPUT_COMPRESSION=75
RECIPE_DISCOVERY_BATCH_SIZE=1
RECIPE_DISCOVERY_MAX_CONCURRENCY=20
RECIPE_DISCOVERY_IMAGE_TIMEOUT_MS=20000

# Laravel recipe source database (PostgreSQL outside development; use a read-only account)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=mealo_recipe_reader
# DB_PASSWORD=
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
